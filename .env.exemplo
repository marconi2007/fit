# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). A chave "anon" é pública por natureza:
# quem protege os dados são as regras de acesso do banco.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Endereço onde a versão web do app fica publicada. Usado nos links de convite
# e de recuperação de senha. Deixe vazio enquanto testa no computador.
EXPO_PUBLIC_APP_URL=
